ister",[52,86,66],{"id":87},"sign-in",[57,89,90,93],{},[60,91,92],{},"Sign in with username or email and password, or with a passkey.",[60,94,95],{},"With two-factor on, enter the code from your authenticator app next.",[82,97],{"name":98,"title":66},"login",[52,100,102],{"id":101},"reset-your-password","Reset your password",[57,104,105,111,117],{},[60,106,107,108,71],{},"On the sign-in page tap ",[64,109,110],{},"Reset password",[60,112,113,114,71],{},"Enter the email of your account and tap ",[64,115,116],{},"Submit",[60,118,119],{},"Open the link in the email (valid 30 minutes) and choose a new password. All other sessions are signed out.",[82,121],{"name":122,"title":102},"reset",[52,124,126],{"id":125},"your-account","Your account",[57,128,129,132],{},[60,130,131],{},"Tap your name at the bottom of the menu.",[60,133,134],{},"Profile, friends, staff tools and the gyms you belong to.",[82,136],{"name":137,"title":126},"account",[52,139,141],{"id":140},"edit-your-profile-and-email","Edit your profile and email",[57,143,144,149,152],{},[60,145,62,146,71],{},[64,147,148],{},"Account → Settings → Profile",[60,150,151],{},"Change name, avatar or banner.",[60,153,154],{},"A new email address needs your password and is active once you open the confirmation link sent to it.",[82,156],{"name":157,"title":141},"settings-profile",[52,159,161],{"id":160},"language-and-theme","Language and theme",[57,163,164],{},[60,165,166,169],{},[64,167,168],{},"Settings → Preferences",": language, light\u002Fdark theme.",[82,171],{"name":172,"title":161},"settings-preferences",[52,174,176],{"id":175},"change-your-password","Change your password",[57,178,179,184],{},[60,180,62,181,71],{},[64,182,183],{},"Settings → Security",[60,185,186],{},"Enter the current and the new password, then save.",[82,188],{"name":189,"title":176},"settings-security",[52,191,193],{"id":192},"turn-on-two-factor-sign-in","Turn on two-factor sign-in",[57,195,196,201,204],{},[60,197,198,71],{},[64,199,200],{},"Set